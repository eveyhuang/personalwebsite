---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base";
import PostPreview from "@/components/blog/PostPreview";

export async function getStaticPaths() {
	const posts = await getCollection("post", ({ data }) => !data.draft);
	return [{ params: { page: undefined }, props: { posts } }];
}

interface Props {
	posts: CollectionEntry<"post">[];
}

const { posts } = Astro.props;
const orderedPosts = [...posts].sort((a, b) => a.data.order - b.data.order);
---

<PageLayout meta={{ title: "Research", description: "Research on AI and collective work: making expertise usable, understanding collaboration, and evaluating collective outcomes." }}>
	<section>
		<div class="section-head">
			<h1>Research and projects</h1>
			<p class="section-label">Human-AI collaborations | Organizations | HCI & Design | Computational Social Science</p>
		</div>
		<p class="max-w-3xl text-[1.02rem] text-muted">
			My work takes a mixed-methods, interdisciplinary approach and leverages in-depth qualitative investigations, computational social science, system design and field deployment, and AI-enabled measurement.
		</p>
	</section>

	<section class="section-block max-w-4xl" aria-label="Research streams and industry work">
		<ul class="post-list text-start">
			{orderedPosts.map((post) => (
				<li class="post-list-item"><PostPreview post={post} as="h2" withDesc /></li>
			))}
		</ul>
		<p class="mt-6 text-sm"><a class="cactus-link" href="/publications">View all publications and manuscripts</a></p>
	</section>
</PageLayout>
